# Solana
SOLANA_PRIVATE_KEY=your_base58_private_key

# RPC
HELIUS_API_KEY=your_helius_api_key

# LLM
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_API_KEY=your_llm_api_key
LLM_MODEL=glm-5-turbo

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=

# Qdrant (optional, defaults to local)
QDRANT_URL=https://your-qdrant-instance:6333
QDRANT_API_KEY=your_qdrant_api_key

# Birdeye (optional, for token research fallback)
BIRDEYE_API_KEY=your_birdeye_api_key

# LPAgent (supports comma-separated for key rotation)
LPAGENT_API_KEY=your_lpagent_api_key

# Jupiter Swap API (supports comma-separated for key rotation)
JUPITER_API_KEY=your_jupiter_api_key

# Logging
LOG_LEVEL=info
